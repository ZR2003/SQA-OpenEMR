# Environment variables for login, patient records, search, scheduling, and billing tests
# Copy this file to .env and fill in values for an authorized OpenEMR test instance.
BASE_URL=https://demo.openemr.io/openemr
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=pass
# Optional test patient details. Use synthetic/demo data only.
TEST_PATIENT_FIRST=Automation
TEST_PATIENT_LAST=TestPatient
TEST_PATIENT_DOB=1990-01-15
TEST_PATIENT_GENDER=Male
TEST_SEARCH_TERM=Phil
TEST_PROVIDER=
TEST_APPOINTMENT_DATE=2026-12-15
TEST_APPOINTMENT_TIME=09:00:00

TEST_BILLING_AMOUNT=100

TEST_BILLING_AMOUNT=200000
